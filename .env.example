VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Fase 31 — Web Push. Es la mitad PÚBLICA del par VAPID (segura de exponer en
# el bundle del cliente); la privada NUNCA va acá, sólo como secret de la Edge
# Function `send-reminders` (ver supabase/functions/send-reminders/.env.example).
# Generar el par con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=tu-vapid-public-key
